# .env olarak kopyala ve doldur. .env commit'lenmez.

# Telegram (rapor kanalı)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM (LiteLLM). Model maliyet testinden sonra seçilecek. Biçim: anthropic/claude-sonnet-5-5
LLM_MODEL=
LLM_API_KEY=

# Lab (VPS). LAB_BIND_IP: VPS'in Tailscale IP'si. WATCHER_PUBLIC_IP: VPS'in genel IP'si (yalnız kapalılık testi için)
LAB_BIND_IP=
WATCHER_PUBLIC_IP=

# Lab Postgres parolası. URL'de kullanıldığı için hex olsun: python3 -c 'import secrets; print(secrets.token_hex(16))'
POSTGRES_PASSWORD=

# Grafana admin parolası (deploy marker yazar). Anonim erişim yalnız okur.
GRAFANA_ADMIN_PASSWORD=
